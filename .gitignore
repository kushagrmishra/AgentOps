node_modules/
dist/
*.tsbuildinfo
.vite/

# --- Tooling ------------------------------------------------------------------
coverage/
playwright-report/
test-results/
client/e2e/screenshots/

# --- OS / editor --------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Agent workspace (keep the seed README)
server/workspace/*
!server/workspace/README.md

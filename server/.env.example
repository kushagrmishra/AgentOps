# =============================================================================
# AgentOps — environment checklist by stage
# Copy to server/.env and client/.env as needed. Never commit real secrets.
# =============================================================================

ENVIRONMENT=development

# --- Stage 1: Clerk + Postgres + origins ------------------------------------
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
# client/.env:
#   VITE_CLERK_PUBLISHABLE_KEY=
CLIENT_ORIGIN=http://localhost:5173
MARKETING_ORIGIN=http://localhost:5174
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

# --- Stage 2: Anthropic (required for real runs) ----------------------------
# Free orgs: customer BYOK in dashboard /api.
# Pro/Max: set the platform key here (customers do not paste a key).
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5-20250929

# --- Stage 3: E2B sandboxes -------------------------------------------------
E2B_API_KEY=

# --- Stage 4: Stripe + Upstash ----------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
STRIPE_PRICE_TEAM=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Stage 5: Resend + Sentry + PostHog -------------------------------------
RESEND_API_KEY=
EMAIL_FROM=AgentOps <onboarding@agentops.dev>
SENTRY_DSN=
# client/.env:
#   VITE_SENTRY_DSN=
#   VITE_POSTHOG_KEY=
#   VITE_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Stage 6: production lock -----------------------------------------------
# ENVIRONMENT=production
# CLIENT_ORIGIN=https://app.agentops.com
# (CORS locks to CLIENT_ORIGIN only when ENVIRONMENT=production)

# --- Stage 7: CI (GitHub Actions secrets) -----------------------------------
# Mirror the above in repo secrets for optional deploy jobs.
